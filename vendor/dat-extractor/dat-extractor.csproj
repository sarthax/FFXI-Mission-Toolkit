<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DatExtractor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConversionTables\*.dat">
      <LogicalName>ConversionTables.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\ROMFileMappings.xml">
      <LogicalName>Data.ROMFileMappings.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\Messages.xml">
      <LogicalName>Data.Messages.resx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
